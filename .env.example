# Site vertical. Defaults to automotive when omitted for backward compatibility.
# Supported values: automotive, home_services.
SITE_PROFILE="automotive"

# Required: MySQL/MariaDB connection used by Prisma.
DATABASE_URL="mysql://app_user:change-me@127.0.0.1:3306/blog_engine"

# Required: long random values. Never commit real production secrets.
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Required in production: canonical HTTPS origin without a trailing slash.
NEXT_PUBLIC_SITE_URL="https://example.com"

# Optional: comma-separated trusted origins for admin mutations.
ADMIN_ALLOWED_ORIGINS="https://www.example.com"
REDIRECT_ALLOWED_ORIGINS=""

# Optional: comma-separated HTTPS hosts accepted by next/image.
IMAGE_REMOTE_HOSTS="cdn.example.com"

# Required for persistent local media unless external/object storage is used.
UPLOAD_STORAGE_DIR="/var/lib/blog-engine/uploads"

# Optional: comma-separated HTTPS hosts permitted in custom head resources.
CUSTOM_HEAD_ALLOWED_HOSTS="www.googletagmanager.com,www.google-analytics.com"
